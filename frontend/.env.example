# NEXi Voice Assistant Frontend Configuration
# URL to Python Token and RAG API service.
# For local development: http://localhost:8080
# For production (Vercel): leave blank to use relative API routing, or provide your deployed backend URL (e.g. https://api.nexi.your-domain.edu)
VITE_BACKEND_URL=http://localhost:8080

# LiveKit WebRTC Cloud / Self-hosted WebSocket endpoint (e.g. wss://your-domain.livekit.cloud)
VITE_LIVEKIT_URL=wss://your-project.livekit.cloud
