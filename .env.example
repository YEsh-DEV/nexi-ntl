# Copy to .env.local and fill in values. Never commit actual credentials.
# All active settings below are implemented in Phase 0/1.
# Existing shell variables override .env.local. In production, set NEXI_ENV in
# the process environment: production does not load the local dotenv file.
NEXI_ENV=development
LOG_LEVEL=INFO
TIMEZONE=Asia/Kolkata

# Required for dev/start/connect; not required for console or offline ingestion.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Empty means automatic dispatch in Phase 1/2. Named dispatch arrives in Phase 3.
AGENT_NAME=

# Required for voice sessions (including console); no defaults or fake credentials.
DEEPGRAM_API_KEY=
GOOGLE_API_KEY=
SARVAM_API_KEY=
# Use uppercase SARVAM_API_KEY; the old lowercase setting is not read.

# English-only Phase 1 profile. These are SDK-supported options, not live-tested
# provider availability. Confirm model access when keys are supplied.
STT_MODEL=nova-3
STT_LANGUAGE=en-US
LLM_MODEL=gemini-2.5-flash
TTS_MODEL=bulbul:v2
TTS_SPEAKER=anushka
WEB_SAMPLE_RATE=24000
PHONE_SAMPLE_RATE=8000
# Enable only for a LiveKit Cloud deployment that supports the BVC plugin.
# Console skips noise cancellation. False also supports local LiveKit servers.
NOISE_CANCELLATION=false

# Relative paths are resolved from this repository, not the shell's working directory.
# Keep existing PDFs in their canonical folder instead of duplicating/moving them.
PDF_DIR=./uni_pdfs
JSON_DIR=./data/json
# Versioned directories and a CURRENT file are created ONLY by python -m rag.ingest.
CHROMA_DIR=./data/knowledge
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_REVISION=233902d25c440f23af6f7d6e94d2946bac0bee0a
# PROVISIONAL raw cross-encoder score. Calibration is Phase 2; not a probability.
RERANK_MIN_SCORE=0.0
SEARCH_TIMEOUT=6
RETRIEVAL_K=12
RETRIEVAL_TOP_N=4
CONTEXT_MAX_CHARS=4000
QUERY_MAX_CHARS=1000
INFERENCE_THREADS=1

# Seconds; prewarm reads cached models and an already-built artifact.
PREWARM_TIMEOUT=120
PARTICIPANT_TIMEOUT=30
SPEECH_TIMEOUT=15
SHUTDOWN_TIMEOUT=10
# Each idle process has its own models/RAM. Use zero on a constrained dev machine.
IDLE_PROCESSES=1

# Reserved for later phases; NOT consumed by Phase 1 code. Do not fill these yet.
# Phase 3: TWILIO_ACCOUNT_SID, TWILIO_AUTH_TOKEN, INBOUND_PHONE_NUMBER,
#          LIVEKIT_SIP_HOST, SIP_TRUNK_ID, SIP_DISPATCH_RULE_ID
# Phase 4: SARVAM_STT_MODEL and validated multilingual voice profiles
# Phase 5: frontend server-only LIVEKIT_* credentials, CAPTCHA_SECRET_KEY,
#          a distributed token-route rate limiter, MAX_CALL_SECONDS
# Phase 6: telemetry database/retention settings, deployment-specific spend limits
