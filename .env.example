# ==============================================================================
# Nexi Campus Voice Assistant - Environment Configuration
# ==============================================================================
# Copy this file to .env.local for local development.
# In production, set these via container environment variables or vault.

# ------------------------------------------------------------------------------
# 1. LiveKit Server & Named Dispatch
# ------------------------------------------------------------------------------
# LiveKit Cloud or self-hosted endpoint (wss:// for production, ws:// for local)
LIVEKIT_URL=wss://your-project.livekit.cloud

# LiveKit project credentials
LIVEKIT_API_KEY=your_livekit_key
LIVEKIT_API_SECRET=your_livekit_secret

# Named dispatch agent identifier (MUST match telephony dispatch rule and web tokens)
AGENT_NAME=nexi

# Allow running without named dispatch (development only; 0 or 1)
ALLOW_AUTO_DISPATCH=0

# ------------------------------------------------------------------------------
# 2. AI Providers
# ------------------------------------------------------------------------------
# Google Gemini API key (LLM reasoning and tool calling)
GOOGLE_API_KEY=your_gemini_api_key

# Deepgram API key (English STT transcription)
DEEPGRAM_API_KEY=your_deepgram_api_key

# Sarvam AI API key (Bulbul TTS speech generation and Indian language STT)
SARVAM_API_KEY=your_sarvam_api_key

# Allow untested provider plugin versions (development only; 0 or 1)
ALLOW_UNTESTED_PROVIDER_VERSIONS=0

# ------------------------------------------------------------------------------
# 3. Agent Runtime & Spoken Models
# ------------------------------------------------------------------------------
# Environment tier (development | production)
ENVIRONMENT=development
NEXI_ENV=development

# Logging verbosity (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# Campus local IANA timezone
TIMEZONE=Asia/Kolkata

# Model names
LLM_MODEL=gemini-3.5-flash
STT_MODEL=nova-3
STT_LANGUAGE=en-US
TTS_MODEL=bulbul:v3
TTS_SPEAKER=kavya
DEFAULT_LANGUAGE=en

# Audio sample rates (Hz)
WEB_SAMPLE_RATE=24000
PHONE_SAMPLE_RATE=8000

# Noise cancellation (true | false)
NOISE_CANCELLATION=false

# Worker idle processes (0-4)
IDLE_PROCESSES=1

# ------------------------------------------------------------------------------
# 4. Call Lifecycle & Timeouts (Seconds)
# ------------------------------------------------------------------------------
# Hard call duration limits
MAX_CALL_SECONDS_WEB=300.0
MAX_CALL_SECONDS_PHONE=600.0
CALL_WARNING_LEAD_S=30.0

# Silence & Inactivity monitoring
IDLE_SILENCE_TIMEOUT=8.0
IDLE_SILENCE_GRACE=8.0

# Framework timeouts
PREWARM_TIMEOUT=120.0
PARTICIPANT_TIMEOUT=30.0
SPEECH_TIMEOUT=15.0
SHUTDOWN_TIMEOUT=10.0

# Lifecycle teardown bounds
FAREWELL_TIMEOUT_S=8.0
SESSION_CLOSE_TIMEOUT_S=5.0
ROOM_DELETE_TIMEOUT_S=5.0
TELEMETRY_DRAIN_TIMEOUT_S=5.0
END_CALL_TOTAL_TIMEOUT_S=25.0

# ------------------------------------------------------------------------------
# 5. Telephony & Office Transfer
# ------------------------------------------------------------------------------
# Allowlisted department transfer targets (JSON object mapping department to E.164 number)
# Example: {"admissions": "+918000000001", "accounts": "+918000000002", "general": "+918000000000"}
TRANSFER_TARGETS=

# Transfer timeouts
TRANSFER_TIMEOUT_S=10.0
TRANSFER_GRACE_S=15.0

# Language menu & switching
LANGUAGE_MENU_TIMEOUT_S=8.0
MAX_LANGUAGE_SWITCHES=5

# ------------------------------------------------------------------------------
# 6. Knowledge & Hybrid Retrieval
# ------------------------------------------------------------------------------
PDF_DIR=uni_pdfs
JSON_DIR=data/json
CHROMA_DIR=data/knowledge

EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_REVISION=1110a243fdf4706b3f48f1d95db1a4f5529b4d41
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_REVISION=233902d25c440f23af6f7d6e94d2946bac0bee0a
RERANK_MIN_SCORE=0.0

SEARCH_TIMEOUT=6.0
RETRIEVAL_K=12
RETRIEVAL_TOP_N=4
CONTEXT_MAX_CHARS=4000
QUERY_MAX_CHARS=1000
INFERENCE_THREADS=1

# Allow loading unverified knowledge index (development only; 0 or 1)
ALLOW_UNVERIFIED_KNOWLEDGE=0

# ------------------------------------------------------------------------------
# 7. Operational Telemetry & Privacy
# ------------------------------------------------------------------------------
TELEMETRY_QUEUE_SIZE=1000
TELEMETRY_SPILL_PATH=

# Secret HMAC key for caller number hashing (REQUIRED in production)
PII_HASH_KEY=

# JSON list of custom regex patterns for student PII redaction
PII_EXTRA_PATTERNS=

# Retention windows (days)
CALL_LOG_RETENTION_DAYS=90
TURN_METRICS_RETENTION_DAYS=30
KNOWLEDGE_GAP_RETENTION_DAYS=180

# ------------------------------------------------------------------------------
# 8. Token API Service & Admission Controls
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8080
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://127.0.0.1:3000
TOKEN_TTL_S=600.0

# Rate limits
TOKEN_RATE_PER_IP=10
TOKEN_RATE_WINDOW_S=600.0
TOKEN_RATE_GLOBAL_PER_MIN=60
TRUSTED_PROXIES=

# Admission and quota caps
MAX_CONCURRENT_CALLS=5
MAX_TOKENS_PER_DAY=300
ADMISSION_FAIL_OPEN=false

# Worker healthcheck and bot protection
WORKER_HEALTH_URL=http://127.0.0.1:8081/healthz
REQUIRE_CAPTCHA=false
